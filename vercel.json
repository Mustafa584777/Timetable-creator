{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/firebase-applet-config.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.timetablecreator.online"
        }
      ],
      "destination": "https://timetablecreator.online/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/timetable-generator-online-for-students/:lang",
      "destination": "/timetable-generator-online-for-students/:lang/index.html"
    },
    {
      "source": "/timetable-generator-online-for-students",
      "destination": "/timetable-generator-online-for-students/index.html"
    },
    {
      "source": "/timetable-generator-online-for-students/",
      "destination": "/timetable-generator-online-for-students/index.html"
    },
    {
      "source": "/timetable-generator/:lang",
      "destination": "/timetable-generator/:lang/index.html"
    },
    {
      "source": "/timetable-generator",
      "destination": "/timetable-generator/index.html"
    },
    {
      "source": "/timetable-generator/",
      "destination": "/timetable-generator/index.html"
    },
    {
      "source": "/html-sitemap/:lang",
      "destination": "/html-sitemap/:lang/index.html"
    },
    {
      "source": "/html-sitemap",
      "destination": "/html-sitemap/index.html"
    },
    {
      "source": "/html-sitemap/",
      "destination": "/html-sitemap/index.html"
    },
    {
      "source": "/sitemap/:lang",
      "destination": "/sitemap/:lang/index.html"
    },
    {
      "source": "/sitemap.html",
      "destination": "/sitemap.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/blog/:slug*"
    },
    {
      "source": "/:lang(en-GB|en|es|ja|fr|de|pt|ko|it|hi)",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:lang(en-GB|en|es|ja|fr|de|pt|ko|it|hi)/",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/:toolSlug",
      "destination": "/:toolSlug/index.html"
    },
    {
      "source": "/:toolSlug/",
      "destination": "/:toolSlug/index.html"
    },
    {
      "source": "/((?!api/|blog/|assets/|favicon|timetable-generator|timetable-creator|sitemap|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
