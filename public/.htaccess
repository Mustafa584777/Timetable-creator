RewriteEngine On

# Force HTTPS + Remove www (ek hi redirect mein)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]

# 301 Redirect old query-parameter multilingual URLs (?lang=xx) to clean URLs
RewriteCond %{QUERY_STRING} (?:^|&)lang=(es|ja|fr|de|pt|ko|it|hi)(?:&|$) [NC]
RewriteRule ^$ /%1/? [R=301,L]

RewriteCond %{QUERY_STRING} (?:^|&)lang=(en-GB|en)(?:&|$) [NC]
RewriteRule ^$ /? [R=301,L]

RewriteCond %{QUERY_STRING} (?:^|&)lang=(es|ja|fr|de|pt|ko|it|hi)(?:&|$) [NC]
RewriteRule ^([^/]+)/?$ /$1/%1/? [R=301,L]

RewriteCond %{QUERY_STRING} (?:^|&)lang=(en-GB|en)(?:&|$) [NC]
RewriteRule ^([^/]+)/?$ /$1/? [R=301,L]

# SPA fallback for virtual paths
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(timetable-generator-online-for-students|admin-panel)/?.*$ /index.html [L,QSA]
